# 服金诀六式。金量费用由 meridian_piglin:gold 附属支付方原子扣除。
schema_version: 1
namespace: "meridian_piglin"
binding_templates { id: "meridian_piglin:piglin" version: 1 }

books {
  id: "meridian_piglin:gold_eating"
  display_name: "服金诀"
  arm_rules {
    ignore_held_items: true
    require_grounded: false
    base_damage { value: 1 unit: DAMAGE_POINT }
  }
}

volumes {
  id: "meridian_piglin:gold_eating_upper"
  book_id: "meridian_piglin:gold_eating"
  display_name: "服金诀·上卷·金皮"
  techniques { id: "meridian_piglin:swallow_gold" version: 1 }
  techniques { id: "meridian_piglin:gilding" version: 1 }
  techniques { id: "meridian_piglin:coin_dart" version: 1 }
}

volumes {
  id: "meridian_piglin:gold_eating_middle"
  book_id: "meridian_piglin:gold_eating"
  display_name: "服金诀·中卷·铸像"
  techniques { id: "meridian_piglin:midas_touch" version: 1 }
  techniques { id: "meridian_piglin:gold_cast" version: 1 }
  techniques { id: "meridian_piglin:devour" version: 1 }
  prerequisite_volume_ids: "meridian_piglin:gold_eating_upper"
}

definitions {
  id: "meridian_piglin:swallow_gold"
  version: 1
  category: BUFF
  minimum_realm: WANDERING_QI
  slots {
    id: "hand_meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 1
    maximum_count: 6
    require_opened: true
  }
  cost { qi {
    slot_id: "hand_meridians"
    matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
    phase: FREE
    amount { value: 0.1 unit: QI }
    distribution: EVEN
  } }
  phases { warmup_millis: 1500 active_millis: 0 recovery_millis: 0 interruptible_by_damage: true }
  cooldown_millis: 60000
  effects { at_millis: 0 presentation {
    id: "meridian_piglin:swallow_gold"
    duration: UNTIL_RECOVERY_END
    start_millis: 0
  } }
  effects { at_millis: 1500 status_benefit {
    id: "meridian_piglin:feeding"
    duration_millis: 10000
    color_rgb: 16766720
    plain { movement_speed_multiplier: 0 }
  } }
  presentation {
    icon_id: "meridian_piglin:swallow_gold"
    display_name: "服金"
    description: "站定吞下身上的金，把金囊里的金化作服金诀的引子。"
  }
  movement_speed_multiplier: 0
}

definitions {
  id: "meridian_piglin:gilding"
  version: 1
  category: BUFF
  minimum_realm: WANDERING_QI
  slots {
    id: "hand_meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 2
    maximum_count: 6
    require_opened: true
  }
  cost {
    qi {
      slot_id: "hand_meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: FREE
      amount { value: 0.2 unit: QI }
      distribution: EVEN
    }
    addon_costs { key: "meridian_piglin:gold" amount { value: 3 unit: GOLD } }
  }
  phases { warmup_millis: 500 active_millis: 0 recovery_millis: 200 interruptible_by_damage: false }
  cooldown_millis: 30000
  effects { at_millis: 500 status_benefit {
    id: "meridian_piglin:gilded"
    duration_millis: 12000
    color_rgb: 16766720
    plain { movement_speed_multiplier: 0.85 }
  } }
  presentation {
    icon_id: "meridian_piglin:gilding"
    display_name: "鎏金"
    description: "皮上泛起金色，斩击、刺击和火焰都被金皮削弱，脚步也随之沉重。"
  }
  movement_speed_multiplier: 0.85
}

definitions {
  id: "meridian_piglin:coin_dart"
  version: 1
  category: ATTACK
  minimum_realm: WANDERING_QI
  slots {
    id: "hand_meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 2
    maximum_count: 6
    require_opened: true
  }
  cost {
    qi {
      slot_id: "hand_meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: FREE
      amount { value: 0.2 unit: QI }
      distribution: EVEN
    }
    addon_costs { key: "meridian_piglin:gold" amount { value: 1 unit: GOLD } }
  }
  phases { warmup_millis: 400 active_millis: 0 recovery_millis: 0 interruptible_by_damage: true }
  cooldown_millis: 3000
  effects { at_millis: 400 sound {
    sound_id: "minecraft:entity.snowball.throw"
    anchor: CASTER
    volume { value: 0.7 unit: RATIO }
    pitch { value: 1 unit: RATIO }
    pitch_jitter { value: 0.05 unit: RATIO }
  } }
  presentation {
    icon_id: "meridian_piglin:coin_dart"
    display_name: "金钱镖"
    description: "甩出一粒金，穿过直线上的敌人后落在地上，谁捡到便归谁。"
  }
  movement_speed_multiplier: 0.4
}

definitions {
  id: "meridian_piglin:midas_touch"
  version: 1
  category: ATTACK
  minimum_realm: TRUE_QI
  slots {
    id: "hand_meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 6
    maximum_count: 6
    require_opened: true
  }
  cost {
    qi {
      slot_id: "hand_meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: FREE
      amount { value: 0.3 unit: QI }
      distribution: EVEN
    }
    addon_costs { key: "meridian_piglin:gold" amount { value: 5 unit: GOLD } }
  }
  phases { warmup_millis: 600 active_millis: 0 recovery_millis: 300 interruptible_by_damage: true }
  cooldown_millis: 20000
  effects { at_millis: 600 limb_strike {
    shape: SINGLE_TARGET
    facing: STRIKE_FORWARD
    distance { value: 2.5 unit: METER }
    angle { value: 60 unit: DEGREE }
    multiplier { value: 1 unit: RATIO }
    maximum_targets: 1
    cast_target_limit: 1
    arm: FRONT_ARM
    damage_type_id: "meridian_piglin:midas_touch"
    knockback_kind: NONE
    knockback { value: 0 unit: RATIO }
    knockback_when_blocked: false
    last_strike: true
    dedup_group: "midas_touch"
  } }
  presentation {
    icon_id: "meridian_piglin:midas_touch"
    display_name: "点金"
    description: "近身一掌，把命中的金属甲和手中金属兵器暂时点成金。"
  }
  movement_speed_multiplier: 0.4
}

definitions {
  id: "meridian_piglin:gold_cast"
  version: 1
  category: BUFF
  minimum_realm: TRUE_QI
  slots {
    id: "hand_meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 6
    maximum_count: 6
    require_opened: true
  }
  slots {
    id: "leg_muscles"
    module: TISSUE
    tags: "human:leg_muscle"
    minimum_count: 1
    maximum_count: 6
  }
  cost {
    qi {
      slot_id: "hand_meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: FREE
      amount { value: 0.3 unit: QI }
      distribution: EVEN
    }
    addon_costs { key: "meridian_piglin:gold" amount { value: 9 unit: GOLD } }
  }
  phases { warmup_millis: 700 active_millis: 5000 recovery_millis: 3000 interruptible_by_damage: false }
  cooldown_millis: 90000
  effects { at_millis: 700 presentation {
    id: "meridian_piglin:gold_cast"
    duration: UNTIL_RECOVERY_END
    start_millis: 0
  } }
  effects { at_millis: 700 status_benefit {
    id: "meridian_piglin:gold_cast"
    duration_millis: 5000
    color_rgb: 16766720
    plain { movement_speed_multiplier: 0 }
  } }
  presentation {
    icon_id: "meridian_piglin:gold_cast"
    display_name: "铸金"
    description: "五息铸成金像，钝、斩、刺与真元附伤都被金身压低，期间不能移动出手。"
  }
  movement_speed_multiplier: 0
}

definitions {
  id: "meridian_piglin:devour"
  version: 1
  category: ATTACK
  minimum_realm: TRUE_QI
  slots {
    id: "hand_meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 6
    maximum_count: 6
    require_opened: true
  }
  slots {
    id: "head"
    module: ORGAN
    kind: "human:brain"
    minimum_count: 1
    maximum_count: 1
  }
  cost {
    qi {
      slot_id: "hand_meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: FREE
      amount { value: 0.3 unit: QI }
      distribution: EVEN
    }
  }
  phases { warmup_millis: 800 active_millis: 0 recovery_millis: 0 interruptible_by_damage: true }
  cooldown_millis: 25000
  effects { at_millis: 800 sound {
    sound_id: "minecraft:entity.piglin.ambient"
    anchor: CASTER
    volume { value: 0.7 unit: RATIO }
    pitch { value: 1 unit: RATIO }
    pitch_jitter { value: 0.05 unit: RATIO }
  } }
  presentation {
    icon_id: "meridian_piglin:devour"
    display_name: "吞宝"
    description: "近身一抓，把对方手里的金器或身上的金锭、金粒夺来吞进金囊。"
  }
  movement_speed_multiplier: 0.4
}
